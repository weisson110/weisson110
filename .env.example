# Provider Selection – Task 5
# mock (default, works without keys) | openai | anthropic | openrouter
PROVIDER=mock

# Real Provider Keys – set only if you use real provider
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=sk-or-v1-...
# For OpenRouter proxy headers
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Database – Task 4
# If not set, uses mockStore (in-memory). If set, uses Prisma + Postgres
# Example: postgresql://user:password@localhost:5432/openrouter
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openrouter

# Redis for rate limiting (Task 6) – optional, falls back to in-memory
# Example: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Stripe / Local Payments – Task 2
STRIPE_SECRET_KEY=sk_test_...
BILLPLZ_API_KEY=...
TOYYIBPAY_API_KEY=...
